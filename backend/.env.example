# Copy to .env (optional). All values have safe development defaults.
DATABASE_URL=sqlite:///./itsm.db
SECRET_KEY=change-this-in-production-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
SLA_MONITOR_ENABLED=true
SLA_MONITOR_INTERVAL_SECONDS=60
SEED_DEMO_DATA=true

# Production start (only used when SEED_DEMO_DATA=false and the database is empty):
# APP_ENV=production
# SEED_DEMO_DATA=false
# INITIAL_ADMIN_EMAIL=you@yourcompany.com
# INITIAL_ADMIN_PASSWORD=choose-a-strong-password-1
# INITIAL_ADMIN_NAME=Your Name
