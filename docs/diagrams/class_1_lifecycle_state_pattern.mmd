---
title: Incident lifecycle (State pattern)
---
classDiagram
    direction TB
    class IncidentState {
        <<abstract>>
        +status: IncidentStatus
        +rules() dict*
        +rule_for(target) UnionType
        +next_statuses() list
    }
    class NewState {
        +status
        +rules()
    }
    class ClassifiedState {
        +status
        +rules()
    }
    class AssignedState {
        +status
        +rules()
    }
    class AcknowledgedState {
        +status
        +rules()
    }
    class InProgressState {
        +status
        +rules()
    }
    class ResolvedState {
        +status
        +rules()
    }
    class VerifiedState {
        +status
        +rules()
    }
    class ClosedState {
        +status
        +rules()
    }
    class StateFactory {
        +for_status(status) IncidentState$
    }
    class LifecycleManager {
        +validate(current, target, actor_kinds, payload) TransitionRule$
        +allowed_next(current, actor_kinds) list$
    }
    class TransitionRule {
        +target: IncidentStatus
        +allowed: frozenset
        +event: EventType
        +required_fields: tuple
        +description: str
    }
    class IncidentStatus {
        <<enumeration>>
        NEW
        CLASSIFIED
        ASSIGNED
        ACKNOWLEDGED
        IN_PROGRESS
        RESOLVED
        VERIFIED
        CLOSED
    }
    class ActorKind {
        <<enumeration>>
        SYSTEM
        ADMIN
        ASSIGNED_TECH
        REPORTER
    }
    IncidentState <|-- NewState
    IncidentState <|-- ClassifiedState
    IncidentState <|-- AssignedState
    IncidentState <|-- AcknowledgedState
    IncidentState <|-- InProgressState
    IncidentState <|-- ResolvedState
    IncidentState <|-- VerifiedState
    IncidentState <|-- ClosedState
    LifecycleManager ..> StateFactory : uses
    StateFactory ..> "1..*" IncidentState : creates
    IncidentState ..> "1..*" TransitionRule : creates
    IncidentState --> IncidentStatus : status
    TransitionRule --> IncidentStatus : target
    TransitionRule --> "1..*" ActorKind : allowed
